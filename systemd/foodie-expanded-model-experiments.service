[Unit]
Description=Three-model comparison on deterministic expanded Foodie dataset
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/swami/Work/Projects/foodie_revamp
ExecStart=/home/swami/venv/dev_env/bin/python -m foodie.modeling.run_expanded_model_experiments
Restart=on-failure
RestartSec=60
TimeoutStopSec=120
KillSignal=SIGINT

[Install]
WantedBy=default.target
