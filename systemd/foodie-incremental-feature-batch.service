[Unit]
Description=Isolated LLM features for September 2026 Places expansion
After=network.target foodie-ollama-gpu0.service foodie-ollama-gpu1.service
Requires=foodie-ollama-gpu0.service foodie-ollama-gpu1.service

[Service]
Type=simple
WorkingDirectory=/home/swami/Work/Projects/foodie_revamp
ExecStart=/home/swami/venv/dev_env/bin/python -m foodie.features.run_incremental_feature_batch --concurrency 12
Restart=no
TimeoutStopSec=120
KillSignal=SIGINT

[Install]
WantedBy=default.target
